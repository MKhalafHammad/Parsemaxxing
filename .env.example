# Parsemaxxing environment template.
# Copy to .env (`make setup` and `make up` do this) and replace every placeholder.
# .env is git-ignored; never commit it and never put real values in this file.
#
# .env holds bootstrap values: what the stack needs before the engine can read its settings
# store. Runtime settings live in the settings store and secrets in the vault (docs/setup.md,
# "Settings and secrets"). The v1 runtime keys below still work as read-only overrides, and so
# do the secrets: set and not empty here, they win over the vault.
# The KEK and the database passwords used by the containers are Docker secrets in secrets/
# (`make secrets`), never in this file.

# --- LLM (Meta Model API or self-hosted Muse Spark Open) ---

# API key for the Meta Model API, from your Meta developer account's API keys page. Set and
# not empty, it wins over the vault value (setting llm.api_key). To keep it only in the vault,
# run `parsemaxxing settings import-env`, then remove this line or leave it empty; `make up`
# then warns and goes on.
LLM_API_KEY=your-meta-api-key-here

# Required by docker-compose. OpenAI-compatible base URL (setting llm.base_url); while set here
# it overrides the stored setting and shows as "managed by environment". For on-prem mode point
# it at your self-hosted Muse Spark Open endpoint, e.g. https://llm.example.com/v1, so logs
# never leave your network. A URL with a user name or password (user:pass@) is refused.
LLM_BASE_URL=https://api.meta.ai/v1

# Required by docker-compose. Model name sent to the endpoint above (setting llm.model).
LLM_MODEL=muse-spark-1.3

# --- Splunk Enterprise (docker-compose service "splunk") ---

# Required. Setting this means YOU accept the Splunk Enterprise license.
SPLUNK_START_ARGS=--accept-license

# Required by Splunk 10.x images. Setting this means YOU accept the
# Splunk General Terms (https://www.splunk.com/en_us/legal/splunk-general-terms.html).
SPLUNK_GENERAL_TERMS=--accept-sgt-current-at-splunk-com

# Required. Password for the Splunk "admin" user, created on first start.
# At least 8 characters. `make env` (or `make up`) replaces this placeholder with a random one.
SPLUNK_PASSWORD=changeme-to-a-long-password

# Optional. Host port for Splunk Web (bound to 127.0.0.1). Default 8000.
SPLUNK_WEB_PORT=8000

# Splunk REST management host and port for the host CLI and the lab probes (settings
# splunk.host and splunk.port, environment "lab"). Inside docker-compose the engine always uses
# "splunk" (a relay to Splunk's port 8089). From your machine, use the lab VM's address (8089 is
# not published by docker-compose; see docs/lab-findings.md). Use a placeholder like
# splunk.example.com here, never a real hostname or IP.
SPLUNK_HOST=splunk.example.com
SPLUNK_PORT=8089

# Bootstrap. A directory that the engine writes add-on packages (.tgz) into and splunkd can
# read, at the same path on the Splunk host (docs/lab-findings.md, Q6). The Docker image sets
# its own.
PARSEMAXXING_PACKAGES_DIR=/opt/parsemaxxing/packages

# The one shared test index every test ingest goes to (setting splunk.test_index); jobs and
# attempts are told apart by sourcetype. Must start with pmx_. With the Docker stack, `make up`
# creates it; with your own Splunk, create it once in Splunk Web (docs/lab-findings.md, Q9).
PARSEMAXXING_TEST_INDEX=pmx_test

# Optional. Token ceiling per run (prompt + output, reasoning included; setting
# llm.run_token_ceiling). The run stops when it is reached. Default 300000.
PARSEMAXXING_RUN_TOKEN_CEILING=300000

# Optional. Ingest caps into the test index, in MB (settings ingest.job_ingest_mb and
# ingest.daily_ingest_mb): per job, and per day across all jobs. A run that would exceed either
# stops before ingesting. Defaults 20 and 500. docker-compose does not pass these to the engine:
# for the stack, import them with `parsemaxxing settings import-env`.
PARSEMAXXING_JOB_INGEST_MB=20
PARSEMAXXING_DAILY_INGEST_MB=500

# Optional, bootstrap. Where run records, uploads and the ingest counter are kept. Default .runs
# in the repository (the Docker image uses /app/.runs on its own volume).
# PARSEMAXXING_RUNS_DIR=/path/to/runs

# Splunk REST tokens for the service accounts (see docs/design.md, "Splunk service accounts").
# With the Docker stack, `make up` creates the accounts and writes fresh tokens here; leave the
# placeholders. With your own Splunk, create them in Splunk Web (docs/lab-findings.md, "Lab
# setup") and paste them here.
# Set and not empty, SPLUNK_SEARCH_TOKEN and SPLUNK_DEPLOY_TOKEN win over the vault values.
# Each `make up` deletes the old tokens in Splunk and writes new ones here, so the engine
# always gets the current ones (docs/setup.md, "Settings and secrets").
SPLUNK_SEARCH_TOKEN=your-parsemaxxing-search-token-here
SPLUNK_DEPLOY_TOKEN=your-parsemaxxing-deploy-token-here
# Not read by the engine today: `make up` still writes it; the drift pipeline (Phase 22) uses it.
SPLUNK_DRIFT_TOKEN=your-parsemaxxing-drift-token-here

# --- PostgreSQL (docker-compose service "postgres") ---

# Required. Database name and owner account created on first start.
POSTGRES_DB=parsemaxxing
POSTGRES_USER=parsemaxxing

# Bootstrap. Passwords of the database owner and of the engine's limited role
# (parsemaxxing_app, which can append to the ledger but never alter, truncate or disable its
# protection). `make env` replaces the placeholders with random ones (letters and digits only).
# On its first run `make secrets` copies them into secrets/postgres_password and
# secrets/postgres_app_password; the containers read only those files. The host CLI reads them
# from here. Changing them here later does not change the database.
POSTGRES_PASSWORD=changeme-to-a-long-password
POSTGRES_APP_PASSWORD=changeme-to-another-long-password

# Bootstrap. Where the CLI on the host reaches PostgreSQL. PostgreSQL is published only with the
# cli profile (`docker compose --profile cli up -d`), on 127.0.0.1:55432 (5432 is often Splunk
# 10's own internal PostgreSQL: never point at that; 5433-5435 are often taken by local
# proxies). Inside docker-compose the engine uses host "postgres" instead.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

# Optional overrides of the connection built from the values above. DATABASE_URL is the
# engine's; MIGRATE_DATABASE_URL is the owner's, for migrations.
# DATABASE_URL=postgresql://parsemaxxing_app:<password>@127.0.0.1:55432/parsemaxxing
# MIGRATE_DATABASE_URL=postgresql://parsemaxxing:<password>@127.0.0.1:55432/parsemaxxing

# Optional, bootstrap. Path of the vault's key-encryption key (KEK). Containers use the Docker
# secret /run/secrets/pmx_kek (the default). Set it only for the host CLI, which needs a file it
# can read (docs/setup.md, "The KEK").
# PARSEMAXXING_KEK_FILE=/path/to/pmx_kek

# Optional. Overrides the setting backup.age_recipient (an age public key, age1...) for
# `parsemaxxing backup`. `make backup` reads secrets/backup_recipients.txt instead.
# PARSEMAXXING_BACKUP_RECIPIENT=age1...

# --- Engine API and web UI ---

# Optional. Host ports for the engine API and the web UI (both bound to 127.0.0.1).
# Defaults 8080 and 3000.
ENGINE_PORT=8080
WEB_PORT=3000

# --- Optional HTTPS front (docker-compose profile "https", a Caddy reverse proxy with HSTS) ---

# Turn it on with COMPOSE_PROFILES=https. PMX_PUBLIC_HOST is the host name the browser uses
# (default localhost). HTTPS_PORT is the published port (default 8443). HTTPS_BIND is the host
# address it listens on (default 127.0.0.1). Sign-in is built (Phase 13), but exposure beyond
# this machine waits for the Phase 14 hardening, so `make up` refuses a non-loopback HTTPS_BIND
# unless PMX_ALLOW_UNAUTHENTICATED_NETWORK=yes is set in your shell.
# PMX_TLS is "internal" (Caddy's own CA) or
# "/certs/<cert>.pem /certs/<key>.pem" for your own certificate in ./certs.
# COMPOSE_PROFILES=https
# PMX_PUBLIC_HOST=parsemaxxing.example.com
# HTTPS_PORT=8443
# HTTPS_BIND=127.0.0.1
# PMX_TLS=internal

# Not read from this file: the following are set in the process environment, and
# docker-compose sets them for its containers. Set them yourself only when running the
# engine and the UI outside Docker, for example to open the UI from another machine by its
# address (use your own; 192.0.2.10 is a documentation address):
#   engine: ALLOWED_HOSTS=localhost,127.0.0.1
#           WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
#             (comma list of the browser origins the UI is served from; a signed-in request
#             that changes something must come from one of them; WEB_ORIGIN, one value, is
#             still read as a fallback)
#   web:    ENGINE_URL=http://127.0.0.1:8080   HOSTNAME=0.0.0.0
#           ALLOWED_HOSTS=localhost:3000,192.0.2.10:3000
#           WEB_ORIGINS=http://localhost:3000,http://192.0.2.10:3000
# PARSEMAXXING_TRUSTED_PROXIES: IPs or CIDRs whose X-Forwarded-For gives the client IP.
#   docker-compose sets it to the web container only (172.30.10.10, a private Docker address);
#   leave it unset outside Docker unless a proxy you run sits in front of the engine.
#
# CLI through the API: PARSEMAXXING_API_URL (default http://127.0.0.1:8080; may also be set in
# this file) is where `run`, `update`, `approve`, `reject`, `promote`, `rollback` and `kill`
# send requests; plain http only to localhost, 127.0.0.1, ::1 or engine, https otherwise.
# PARSEMAXXING_API_URL=http://127.0.0.1:8080
# The API token (pmxt_...) is never read from this file and never typed on the command line:
# export PARSEMAXXING_API_TOKEN in your shell, or pass --token-file <file> (mode 0600 or 0400).
#
# The demo/ scripts read PARSEMAXXING_API (default http://127.0.0.1:8080) and PARSEMAXXING_UI
# (default http://localhost:3000).

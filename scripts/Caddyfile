# The https profile's reverse proxy (docker-compose.yml service "https"). Values come from the
# service's environment: PMX_PUBLIC_HOST (the host name the browser uses) and PMX_TLS ("internal"
# or "/certs/<cert>.pem /certs/<key>.pem").
{
	admin off
	auto_https disable_redirects
	https_port 8443
}

{$PMX_PUBLIC_HOST}:8443 {
	tls {$PMX_TLS}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# X-Pmx-Hop (the pmx_proxy_hop secret) tells web that X-Forwarded-For was set here; header_up
	# replaces any X-Pmx-Hop the client sent.
	reverse_proxy web:3000 {
		header_up X-Pmx-Hop {file./run/secrets/pmx_proxy_hop}
	}
}
